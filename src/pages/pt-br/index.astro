---
import PortfolioPage from "../../components/PortfolioPage.astro";
import { ptBr } from "../../content/portfolio/pt-br";
import Layout from "../../layouts/Layout.astro";

const baseUrl = import.meta.env.BASE_URL;
---

<Layout
    title={ptBr.meta.title}
    description={ptBr.meta.description}
    language={ptBr.languageTag}
>
    <PortfolioPage content={ptBr} baseUrl={baseUrl} />
</Layout>
