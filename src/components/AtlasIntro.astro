---
import type { PortfolioContent } from "../content/portfolio/schema";

interface Props {
    readonly content: PortfolioContent["atlas"];
}

const { content } = Astro.props;
---

<section class="atlas-intro" data-reveal aria-labelledby="atlas-intro-title">
    <div class="atlas-intro-copy">
        <p class="eyebrow">
            <span>00</span>
            {content.eyebrow}
        </p>
        <h2 id="atlas-intro-title">{content.statement}</h2>
        <p>{content.supportingStatement}</p>
    </div>
    <div class="atlas-constellation" aria-hidden="true">
        <svg
            viewBox="0 0 460 300"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
        >
            <path
                d="M55 222L152 79L269 128L387 48M152 79L176 235L312 236L387 48M55 222L176 235L269 128"
                class="atlas-path"
            />
            <path
                d="M55 222L312 236M152 79L387 48"
                class="atlas-path atlas-path-soft"
            />
            <circle
                cx="55"
                cy="222"
                r="10"
                class="atlas-node atlas-node-green"
            />
            <circle
                cx="152"
                cy="79"
                r="15"
                class="atlas-node atlas-node-cyan"
            />
            <circle
                cx="269"
                cy="128"
                r="10"
                class="atlas-node atlas-node-gold"
            />
            <circle
                cx="387"
                cy="48"
                r="8"
                class="atlas-node atlas-node-green"
            />
            <circle
                cx="176"
                cy="235"
                r="7"
                class="atlas-node atlas-node-cyan"
            />
            <circle
                cx="312"
                cy="236"
                r="14"
                class="atlas-node atlas-node-green"
            />
        </svg>
        <span class="atlas-orbit atlas-orbit-one"></span>
        <span class="atlas-orbit atlas-orbit-two"></span>
    </div>
</section>
