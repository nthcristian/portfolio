---
import type { PortfolioContent } from "../content/portfolio/schema";

interface Props {
    readonly content: PortfolioContent;
    readonly baseUrl: string;
}

const { content, baseUrl } = Astro.props;
const { hero, labels } = content;
---

<section
    class="mx-auto w-full max-w-[90rem] px-5 pb-20 pt-6 sm:px-8 lg:px-12 lg:pb-28 lg:pt-10"
    aria-labelledby="hero-title"
>
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1.35fr)_minmax(20rem,0.65fr)] lg:items-stretch">
        <div class="terminal-panel relative overflow-hidden p-1">
            <div class="relative h-full border border-[var(--line)] bg-[var(--ink)] px-6 py-7 sm:px-9 sm:py-10">
                <div class="mb-12 flex items-center justify-between gap-3 font-mono text-[0.68rem] tracking-[0.08em] text-[var(--muted)]">
                    <span class="flex min-w-0 items-center gap-2 truncate">
                        <span class="size-2 rounded-full bg-[var(--green)] shadow-[0_0_12px_var(--green)]"></span>
                        {hero.prompt}
                    </span>
                    <span
                        class="hidden font-mono text-[var(--cyan)] sm:block"
                        aria-hidden="true"
                    >
                        ● ● ●
                    </span>
                </div>

                <p class="mb-4 font-mono text-xs text-[var(--cyan)]">
                    <span class="text-[var(--green)]">$</span>{" "}
                    {labels.heroCommand}
                </p>
                <h1
                    id="hero-title"
                    class="max-w-3xl text-5xl font-semibold tracking-[-0.06em] text-balance text-[var(--paper)] sm:text-6xl lg:text-7xl"
                >
                    {hero.name}
                </h1>
                <p class="mt-5 max-w-2xl font-mono text-xs leading-relaxed text-[var(--green)] sm:text-sm">
                    {hero.role}
                </p>

                <div class="my-9 h-px w-full bg-[var(--line)]"></div>

                <p class="max-w-2xl text-2xl font-medium leading-tight tracking-[-0.035em] text-[var(--paper)] sm:text-3xl">
                    {hero.statement}
                </p>
                <p class="mt-5 max-w-xl text-base leading-7 text-[var(--muted-strong)]">
                    {hero.supportingStatement}
                </p>

                <div class="mt-10 flex flex-wrap gap-3">
                    {hero.actions.map((action) => (
                        <a
                            class="action-link"
                            href={action.href}
                            target="_blank"
                            rel="noreferrer"
                        >
                            <span>{action.label}</span>
                            <span aria-hidden="true">↗</span>
                            <span class="sr-only">({labels.openExternal})</span>
                        </a>
                    ))}
                </div>

                <div class="mt-10 flex items-center gap-3 border-t border-[var(--line)] pt-5 font-mono text-[0.68rem] uppercase tracking-[0.12em] text-[var(--muted)]">
                    <span class="inline-block size-2 border border-[var(--gold)]"></span>
                    {hero.signal}
                </div>
            </div>
        </div>

        <aside class="hero-portrait relative min-h-[26.25rem] overflow-hidden border border-[var(--line-strong)] bg-[var(--ink-raised)] lg:min-h-full">
            <img
                class="absolute inset-0 size-full object-cover object-[52%_33%] grayscale-[0.15] contrast-110"
                src={`${baseUrl}/selfie.png`}
                width="1086"
                height="1448"
                alt={labels.portraitAlt}
            />
            <div class="absolute inset-0 bg-[linear-gradient(180deg,transparent_30%,rgba(7,10,16,0.9)_100%)]"></div>
            <div class="absolute inset-x-0 bottom-0 p-5">
                <p class="font-mono text-[0.67rem] uppercase tracking-[0.14em] text-[var(--paper)]">
                    {labels.availableForOpportunities}
                </p>
                <p class="mt-2 font-mono text-[0.68rem] text-[var(--cyan)]">
                    {hero.status}
                </p>
            </div>
            <div class="absolute inset-x-0 top-0 h-1 bg-[linear-gradient(90deg,var(--green),var(--cyan),transparent)]"></div>
        </aside>
    </div>
</section>
