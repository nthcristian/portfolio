                d="M102 161H168M102 190H151M102 219H173M102 248H143"
                class="atlas-detail"
            />
            <rect
                x="230"
                y="128"
                width="127"
                height="215"
                rx="7"
                class="atlas-box atlas-box-green"
            />
            <rect
                x="254"
                y="153"
                width="79"
                height="89"
                rx="4"
                class="atlas-surface-green"
            />
            <path d="M254 275H329M254 299H307" class="atlas-detail" />
