    {kind === "planner" && (
        <svg
            viewBox="0 0 600 420"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
        >
            <rect
                x="39"
                y="35"
                width="522"
                height="348"
                rx="10"
                class="atlas-frame"
            />
            <path d="M39 92H561" class="atlas-gridline" />
            <path d="M82 63H207" class="atlas-detail" />
            <rect
                x="77"
                y="129"
                width="130"
                height="210"
                rx="7"
                class="atlas-box"
            />
            <path
                d="M105 164H177M105 196H159M105 228H174M105 260H150"
                class="atlas-detail"
            />
            <rect
                x="244"
                y="129"
                width="244"
                height="210"
                rx="7"
                class="atlas-box"
            />
            <path
                d="M244 181H488M244 233H488M305 129V339M366 129V339M427 129V339"
                class="atlas-gridline"
            />
            <rect
                x="315"
                y="190"
                width="41"
                height="33"
                rx="4"
                class="atlas-surface-green"
            />
            <rect
                x="376"
                y="242"
                width="41"
                height="33"
                rx="4"
                class="atlas-surface-cyan"
            />
            <rect
                x="437"
                y="190"
                width="30"
                height="33"
                rx="4"
                class="atlas-surface-gold"
            />
            <path d="M305 160H467" class="atlas-signal" data-signal-path />
        </svg>
    )}
</div>
